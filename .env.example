# ============================================================================
# Mants Brand Orchestrator — exemplo de variáveis de ambiente
# Copie para .env e ajuste. NUNCA comite o .env real.
# ============================================================================

# ----- Aplicação -----
NODE_ENV=development
# Domínio público da API/web (usado em CORS e links da extensão)
APP_URL=http://localhost:3000
API_BASE_URL=http://localhost:3000

# Feature flag: inserção assistida no ChatGPT (experimental, protegida)
# Quando false, a extensão usa apenas copiar/baixar/abrir (fluxo confiável).
FEATURE_CHATGPT_ASSISTED_INSERTION=false

# ----- Banco de dados (PostgreSQL) -----
# Em dev usamos o Postgres do docker-compose.
DATABASE_URL=postgresql://mants:mants_password@localhost:5432/mants_db

# ----- Auth (Mants — própria conta, NÃO do ChatGPT) -----
# Segredos usados APENAS no backend. Nunca expostos à extensão ou ao bundle.
AUTH_SECRET=change-me-dev-secret-min-32-chars-long-0000000000
SESSION_TTL_SECONDS=28800
REFRESH_TTL_SECONDS=2592000

# ----- Storage (S3-compatible) -----
# Dev: MinIO local (docker-compose). Prod: Cloudflare R2 ou S3.
STORAGE_PROVIDER=minio
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=mants-private
STORAGE_ACCESS_KEY_ID=mants_minio
STORAGE_SECRET_ACCESS_KEY=mants_minio_secret
STORAGE_USE_PATH_STYLE=true
# URLs assinadas expiram em segundos
STORAGE_SIGNED_URL_TTL_SECONDS=900

# ----- Billing (mock em dev) -----
BILLING_PROVIDER=mock
# Mercado Pago / Stripe (preparação, não ativos no MVP)
# MP_ACCESS_TOKEN=
# STRIPE_SECRET_KEY=

# ----- Extensão -----
# Domínio da API autorizado no host_permissions da extensão
EXTENSION_ALLOWED_API_ORIGIN=http://localhost:3000
# Versão mínima da extensão aceita pela API
EXTENSION_MIN_VERSION=0.1.0

# ----- Observabilidade (opcional) -----
# SENTRY_DSN=
LOG_LEVEL=info
