{
  "extends": "./.wxt/tsconfig.json",
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "types": ["wxt/browser", "node"]
  },
  "include": ["src", "wxt.config.ts", ".wxt/types", ".wxt/wxt.d.ts"],
  "exclude": ["node_modules", ".output"]
}
